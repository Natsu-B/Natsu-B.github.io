---
import BoardVisual from "./BoardVisual.astro";
import TagChips from "./TagChips.astro";
import type { HardwareBoard } from "../data/profile";

interface Props {
  board: HardwareBoard;
  compact?: boolean;
}

const { board, compact = false } = Astro.props;
const detailHref = `/boards/${board.slug}/`;
---

<article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
  <div class="grid gap-4 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-stretch">
    <BoardVisual board={board} className="h-full" />

    <div>
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div>
          {board.period && (
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{board.period}</p>
          )}
          <h3 class="mt-1 text-base font-semibold text-slate-800">
            <a href={detailHref}>{board.name}</a>
          </h3>
        </div>
        {board.stage && (
          <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-500">
            {board.stage}
          </span>
        )}
      </div>

      <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{board.summary}</p>
      {!compact && (
        <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{board.description}</p>
      )}

      {board.specs.length > 0 && (
        <dl class="mt-4 grid gap-2 sm:grid-cols-2">
          {board.specs.slice(0, compact ? 4 : 6).map((spec) => (
            <div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
              <dt class="text-[11px] font-medium uppercase tracking-wide text-slate-400">{spec.label}</dt>
              <dd class="mt-1 text-xs font-medium text-slate-700">{spec.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a href={detailHref} class="outline-link">詳細を見る</a>
        {board.repositoryUrl && <a href={board.repositoryUrl} class="outline-link">Repository</a>}
      </div>

      {board.tags.length > 0 && (
        <TagChips
          items={board.tags.map((tag) => ({
            label: tag,
          }))}
          className="mt-4"
        />
      )}
    </div>
  </div>
</article>
