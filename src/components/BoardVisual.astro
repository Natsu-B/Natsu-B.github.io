---
import type { HardwareBoard } from "../data/profile";

interface Props {
  board: HardwareBoard;
  className?: string;
  large?: boolean;
}

const { board, className = "", large = false } = Astro.props;
---

{
  board.image ? (
    <img
      src={board.image.src}
      alt={board.image.alt}
      loading="lazy"
      class:list={[
        "w-full rounded-xl border border-slate-200 bg-slate-100 object-cover",
        large ? "min-h-[320px]" : "min-h-44",
        className,
      ]}
    />
  ) : (
    <div
      class:list={[
        "relative min-h-44 overflow-hidden rounded-xl border border-slate-200 bg-slate-900",
        large && "min-h-[320px]",
        className,
      ]}
      aria-label={`${board.name} PCB placeholder`}
    >
      <div class="absolute inset-0 bg-slate-900"></div>
      <div class="absolute left-8 top-8 h-3 w-3 rounded-full bg-slate-400/70"></div>
      <div class="absolute right-10 top-10 h-3 w-3 rounded-full bg-slate-400/70"></div>
      <div class="absolute bottom-10 left-10 h-3 w-3 rounded-full bg-slate-400/70"></div>
      <div class="absolute bottom-8 right-8 h-3 w-3 rounded-full bg-slate-400/70"></div>

      <div class="absolute left-12 top-16 h-12 w-20 rounded-lg border border-slate-400/50 bg-slate-700/80"></div>
      <div class="absolute right-16 top-20 h-14 w-14 rounded-md border border-slate-400/50 bg-slate-700/80"></div>
      <div class="absolute bottom-16 left-20 h-8 w-28 rounded-md border border-slate-400/50 bg-slate-700/80"></div>
      <div class="absolute bottom-20 right-20 h-9 w-20 rounded-md border border-slate-400/50 bg-slate-700/80"></div>

      <div class="absolute left-24 top-20 h-px w-40 bg-slate-400/60"></div>
      <div class="absolute left-40 top-20 h-24 w-px bg-slate-400/60"></div>
      <div class="absolute bottom-24 left-36 h-px w-52 bg-slate-400/60"></div>
      <div class="absolute bottom-24 right-32 h-20 w-px bg-slate-400/60"></div>
      <div class="absolute left-16 top-32 h-px w-24 bg-slate-500/60"></div>
      <div class="absolute right-24 top-36 h-px w-28 bg-slate-500/60"></div>

      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">KiCad PCB</p>
        <p class="mt-1 text-sm font-semibold text-white">{board.name}</p>
      </div>
    </div>
  )
}
