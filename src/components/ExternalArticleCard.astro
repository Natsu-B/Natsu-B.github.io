---
import type { ExternalArticle } from "../data/externalArticles";
import { encodeTag } from "../lib/articles";
import TagChips from "./TagChips.astro";

interface Props {
  article: ExternalArticle;
}

const { article } = Astro.props;

const tagItems = article.tags.map((tag) => ({
  label: tag,
  href: `/tags/${encodeTag(tag)}/`,
}));
---

<article class="panel panel-hover p-5 sm:p-6">
  <a href={article.url} class="group block">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
          {article.date} / {article.source}
        </p>
        <h3 class="mt-1 text-lg font-semibold text-slate-800 transition-colors group-hover:text-blue-700">
          {article.title}
        </h3>
      </div>
      <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-500">
        External
      </span>
    </div>
    <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{article.description}</p>
  </a>

  {tagItems.length > 0 && <TagChips items={tagItems} className="mt-4" />}
</article>
