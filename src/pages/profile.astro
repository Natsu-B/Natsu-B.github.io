---
import ProfileHeader from "../components/ProfileHeader.astro";
import TagChips from "../components/TagChips.astro";
import { careers, interests, profile, projects, skills, slideDecks } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
import { encodeTag } from "../lib/articles";

const latestSlideDecks = [...slideDecks]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
---

<BaseLayout
  title="Profile | ほたるいか"
  description="ほたるいか の詳細プロフィール、興味分野、スキル、代表プロジェクト。"
>
  <ProfileHeader>
    <p class="whitespace-pre-line leading-8 text-slate-600">{profile.longBio}</p>
  </ProfileHeader>

  <section class="mt-6 grid gap-6 md:grid-cols-2">
    <article class="panel px-6 py-5">
      <h2 class="text-lg font-semibold text-slate-800">Interests</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-slate-600 sm:text-base">
        {interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </article>

    <article class="panel px-6 py-5">
      <h2 class="text-lg font-semibold text-slate-800">Skills</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-slate-600 sm:text-base">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </article>
  </section>

  <section class="mt-6 panel px-6 py-6 sm:px-8 sm:py-8">
    <h2 class="text-xl font-semibold text-slate-800">Career</h2>
    <div class="mt-5 space-y-4">
      {careers.map((career) => (
        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{career.period}</p>
          <h3 class="mt-1 text-base font-semibold text-slate-800">
            {career.url ? <a href={career.url}>{career.title}</a> : career.title}
          </h3>
          <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">{career.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-6 panel px-6 py-6 sm:px-8 sm:py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-semibold text-slate-800">Slides</h2>
      <a href="/slides/" class="text-sm font-medium">すべてのスライドを見る</a>
    </div>
    <div class="mt-5 space-y-4">
      {
        latestSlideDecks.map((slide) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                  {slide.date}
                  {slide.event ? ` / ${slide.event}` : ""}
                </p>
                <h3 class="mt-1 text-base font-semibold text-slate-800">
                  <a href={`/slides/${slide.slug}/`}>{slide.title}</a>
                </h3>
              </div>
              <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium uppercase text-slate-500">
                {slide.format}
              </span>
            </div>
            <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">{slide.description}</p>
            {slide.tags && slide.tags.length > 0 && (
              <TagChips
                items={slide.tags.map((tag) => ({
                  label: tag,
                  href: `/tags/${encodeTag(tag)}/`,
                }))}
                className="mt-3"
              />
            )}
          </article>
        ))
      }
      {
        latestSlideDecks.length === 0 && (
          <p class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 text-sm leading-7 text-slate-600">
            掲載中の発表スライドはまだありません。
          </p>
        )
      }
    </div>
  </section>

  <section class="mt-6 panel px-6 py-6 sm:px-8 sm:py-8">
    <h2 class="text-xl font-semibold text-slate-800">Projects</h2>
    <div class="mt-5 space-y-4">
      {
        projects.map((project) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-800">
                <a href={project.url}>{project.name}</a>
              </h3>
              <a href={project.url} class="text-sm font-medium">
                View
              </a>
            </div>
            <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">{project.description}</p>
            <TagChips
              items={project.tags.map((tag) => ({
                label: tag,
                href: `/tags/${encodeTag(tag)}/`,
              }))}
              className="mt-3"
            />
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-6 panel px-6 py-6 sm:px-8 sm:py-8">
    <h2 class="text-xl font-semibold text-slate-800">Contact</h2>
    <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-600 sm:text-base">
      <li>
        GitHub: <a href={profile.contact.github}>{profile.contact.github}</a>
      </li>
      <li>X: {profile.contact.x}</li>
      <li>Email: {profile.contact.emailMasked}</li>
    </ul>
  </section>
</BaseLayout>
