---
import ArticleCard from "../../components/ArticleCard.astro";
import TagChips from "../../components/TagChips.astro";
import { projects, slideDecks, type Project, type SlideDeck } from "../../data/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  encodeTag,
  getCombinedTagSummaries,
  getPublishedArticles,
  hasTag,
  hasStringTag,
  type Article,
  type TagSummary,
} from "../../lib/articles";

interface Props {
  tag: TagSummary;
  articles: Article[];
  projects: Project[];
  slides: SlideDeck[];
}

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const tags = getCombinedTagSummaries(articles, projects, slideDecks);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      articles: articles.filter((article) => hasTag(article, tag.value)),
      projects: projects.filter((project) => hasStringTag(project.tags, tag.value)),
      slides: slideDecks.filter((slide) => hasStringTag(slide.tags, tag.value)),
    },
  }));
}

const { tag, articles, projects: tagProjects, slides } = Astro.props as Props;
---

<BaseLayout
  title={`#${tag.label} | Tags | ほたるいか`}
  description={`タグ「${tag.label}」の関連コンテンツ一覧。`}
>
  <section class="panel px-6 py-6 sm:px-8 sm:py-8">
    <p class="text-sm text-slate-500">Tag</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-800 sm:text-3xl">#{tag.label}</h1>
    <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{tag.count}件の関連コンテンツがあります。</p>
    <a href="/tags/" class="mt-4 inline-flex text-sm font-medium">すべてのタグへ戻る</a>
  </section>

  <section class="mt-6 space-y-4">
    <h2 class="text-xl font-semibold tracking-tight text-slate-800">Articles</h2>
    {articles.map((article) => <ArticleCard article={article} />)}
    {
      articles.length === 0 && (
        <p class="panel p-5 text-sm text-slate-600">このタグの記事はまだありません。</p>
      )
    }
  </section>

  <section class="mt-8 space-y-4">
    <h2 class="text-xl font-semibold tracking-tight text-slate-800">Projects</h2>
    {
      tagProjects.map((project) => (
        <article class="panel panel-hover p-5 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-slate-800">
              <a href={project.url}>{project.name}</a>
            </h3>
            <a href={project.url} class="text-sm font-medium">View</a>
          </div>
          <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">{project.description}</p>
          <TagChips
            items={project.tags.map((projectTag) => ({
              label: projectTag,
              href: `/tags/${encodeTag(projectTag)}/`,
              active: projectTag.toLowerCase() === tag.value,
            }))}
            className="mt-3"
          />
        </article>
      ))
    }
    {
      tagProjects.length === 0 && (
        <p class="panel p-5 text-sm text-slate-600">このタグのプロジェクトはまだありません。</p>
      )
    }
  </section>

  <section class="mt-8 space-y-4">
    <h2 class="text-xl font-semibold tracking-tight text-slate-800">Slides</h2>
    {
      slides.map((slide) => (
        <article class="panel panel-hover p-5 sm:p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                {slide.date}
                {slide.event ? ` / ${slide.event}` : ""}
              </p>
              <h3 class="mt-1 text-base font-semibold text-slate-800">
                <a href={`/slides/${slide.slug}/`}>{slide.title}</a>
              </h3>
            </div>
            <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium uppercase text-slate-500">
              {slide.format}
            </span>
          </div>
          <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">{slide.description}</p>
          {slide.tags && slide.tags.length > 0 && (
            <TagChips
              items={slide.tags.map((slideTag) => ({
                label: slideTag,
                href: `/tags/${encodeTag(slideTag)}/`,
                active: slideTag.toLowerCase() === tag.value,
              }))}
              className="mt-3"
            />
          )}
        </article>
      ))
    }
    {
      slides.length === 0 && (
        <p class="panel p-5 text-sm text-slate-600">このタグの発表スライドはまだありません。</p>
      )
    }
  </section>
</BaseLayout>
