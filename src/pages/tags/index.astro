---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, slideDecks } from "../../data/profile";
import {
  getCombinedTagSummaries,
  getPublishedArticles,
  hasStringTag,
  hasTag,
} from "../../lib/articles";

const articles = await getPublishedArticles();
const tags = getCombinedTagSummaries(articles, projects, slideDecks);
const tagCards = tags.map((tag) => ({
  ...tag,
  articles: articles.filter((article) => hasTag(article, tag.value)),
  projects: projects.filter((project) => hasStringTag(project.tags, tag.value)),
  slides: slideDecks.filter((slide) => hasStringTag(slide.tags, tag.value)),
}));
---

<BaseLayout title="Tags | ほたるいか" description="全タグ一覧と関連コンテンツ件数。">
  <section class="panel px-6 py-6 sm:px-8 sm:py-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800 sm:text-3xl">Tags</h1>
    <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">
      記事、プロジェクト、発表スライドに付与されているタグ一覧です。
    </p>
  </section>

  <section class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      tagCards.map((tag) => (
        <article class="panel panel-hover px-5 py-4">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <a href={`/tags/${tag.slug}/`} class="font-semibold text-slate-700">#{tag.label}</a>
            <p class="text-sm text-slate-500">{tag.count}件</p>
          </div>
          <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-500">
            <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-1">
              Articles {tag.articles.length}
            </span>
            <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-1">
              Projects {tag.projects.length}
            </span>
            <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-1">
              Slides {tag.slides.length}
            </span>
          </div>
          <div class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            {tag.articles.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Articles</p>
                <ul class="mt-1 space-y-1">
                  {tag.articles.map((article) => (
                    <li>
                      <a href={article.data.externalUrl ?? `/articles/${article.id}/`}>{article.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {tag.projects.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Projects</p>
                <ul class="mt-1 space-y-1">
                  {tag.projects.map((project) => (
                    <li>
                      <a href={project.url}>{project.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {tag.slides.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Slides</p>
                <ul class="mt-1 space-y-1">
                  {tag.slides.map((slide) => (
                    <li>
                      <a href={`/slides/${slide.slug}/`}>{slide.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))
    }
    {
      tagCards.length === 0 && (
        <p class="panel col-span-full p-5 text-sm text-slate-600">
          タグがまだありません。
        </p>
      )
    }
  </section>
</BaseLayout>
