---
import BoardCard from "../../components/BoardCard.astro";
import { hardwareBoards } from "../../data/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";

const sortedBoards = [...hardwareBoards].sort((a, b) => (b.period ?? "").localeCompare(a.period ?? ""));
---

<BaseLayout
  title="Boards | ほたるいか"
  description="ほたるいか がKiCadで設計した基板や、基板に対応するfirmwareの一覧。"
>
  <section class="panel px-6 py-6 sm:px-8 sm:py-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-800">Hardware Boards</h1>
        <p class="mt-2 text-sm leading-7 text-slate-600 sm:text-base">
          KiCadで設計した基板、実装したfirmware、主要部品や設計メモをまとめています。
        </p>
      </div>
      <a href="/profile/" class="text-sm font-medium">Profile に戻る</a>
    </div>

    <div class="mt-6 space-y-4">
      {sortedBoards.map((board) => <BoardCard board={board} />)}
      {sortedBoards.length === 0 && (
        <p class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 text-sm leading-7 text-slate-600">
          掲載中の基板はまだありません。
        </p>
      )}
    </div>
  </section>
</BaseLayout>
