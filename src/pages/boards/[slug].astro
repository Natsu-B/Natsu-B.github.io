---
import BoardVisual from "../../components/BoardVisual.astro";
import TagChips from "../../components/TagChips.astro";
import { hardwareBoards } from "../../data/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { encodeTag } from "../../lib/articles";

export function getStaticPaths() {
  return hardwareBoards.map((board) => ({
    params: { slug: board.slug },
    props: { board },
  }));
}

const { board } = Astro.props;
---

<BaseLayout
  title={`${board.name} | Boards | ほたるいか`}
  description={board.summary}
>
  <article class="panel px-6 py-6 sm:px-8 sm:py-8">
    <a href="/boards/" class="text-sm font-medium">Boards に戻る</a>

    <header class="mt-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          {board.period && (
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{board.period}</p>
          )}
          <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-800 sm:text-3xl">
            {board.name}
          </h1>
        </div>
        {board.stage && (
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-500">
            {board.stage}
          </span>
        )}
      </div>
      <p class="mt-4 text-sm leading-7 text-slate-600 sm:text-base">{board.summary}</p>
      {board.tags.length > 0 && (
        <TagChips
          items={board.tags.map((tag) => ({
            label: tag,
            href: `/tags/${encodeTag(tag)}/`,
          }))}
          className="mt-4"
        />
      )}
    </header>

    <div class="mt-6">
      <BoardVisual board={board} large />
    </div>

    <section class="mt-6">
      <h2 class="text-xl font-semibold text-slate-800">Overview</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{board.description}</p>
    </section>

    {board.specs.length > 0 && (
      <section class="mt-6">
        <h2 class="text-xl font-semibold text-slate-800">Specs</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          {board.specs.map((spec) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{spec.label}</dt>
              <dd class="mt-1 text-sm font-medium text-slate-700 sm:text-base">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {board.highlights.length > 0 && (
      <section class="mt-6">
        <h2 class="text-xl font-semibold text-slate-800">Highlights</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-slate-600 sm:text-base">
          {board.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </section>
    )}

    {board.notes && board.notes.length > 0 && (
      <section class="mt-6">
        <h2 class="text-xl font-semibold text-slate-800">Notes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-slate-600 sm:text-base">
          {board.notes.map((note) => <li>{note}</li>)}
        </ul>
      </section>
    )}

    {board.links.length > 0 && (
      <section class="mt-6">
        <h2 class="text-xl font-semibold text-slate-800">Links</h2>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          {board.links.map((link) => <a href={link.url} class="outline-link">{link.label}</a>)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
